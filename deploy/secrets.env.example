# Copy to keys/mainnet/secrets.env (chmod 600) and fill in. deploy/push-env.sh ships it to the box.
# Solana RPC with getProgramAccounts + getSignaturesForAddress (Helius). ⚠ burst limits: memory rpc-rate-limit-is-a-burst-limit
RPC_URL=https://mainnet.helius-rpc.com/?api-key=
# The project token, launched by the operator with api/platform-launch.mjs. Launching stays closed until it lands.
PROJECT_TICKER=FUND
PROJECT_NAME=Pump Fund
# The wallet that launches $FUND, is its Pumpfun creator and receives its creator rewards. Its key goes in
# keys/mainnet/platform-launcher.json (0600); push-env refuses to ship a key that is not this address.
PLATFORM_WALLET=
# Our own X account (optional): shown in the footer, and coins cannot be launched FOR its numeric id
X_HANDLE=
PLATFORM_X_ID=
# Sign in with X: an X developer app, OAuth 2.0, callback https://pumpfund.family/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# twitterapi.io: looking up the X account a coin is launched for (one paid read per handle per 10 minutes). Nothing is posted.
TWITTERAPI_IO_KEY=
# FOMO wallet payouts (fomoapi:<key>), optional
FOMO_LOOKUP=
# X Money payouts via Peer (api/xmoney.mjs): 1 = on. Fund the Base wallet with a little ETH first
# (FEE_SEED_FILE=keys/mainnet/fee-seed.hex node api/xmoney-wallet.mjs prints it). BASE_RPC_URL optional.
XMONEY_ENABLED=
BASE_RPC_URL=
# GitHub usernames are resolved through GitHub's public API: 60 lookups an hour per IP without a token (the box's IP is
# shared with other projects), 5,000 with one (any personal access token, no scopes needed). Optional.
GITHUB_TOKEN=
# Pinata JWT for coin metadata (pump.fun closed its uploader). ⚠ the free plan holds 500 files: 2 per launch
PINATA_JWT=
# …fund mint keys the box grinds itself (one thread, only while the stock is below this). 0 = never grind on the box:
# keys ground on the Mac are shipped with deploy/ship-vanity.sh. Each launch uses one key.
VANITY_TARGET=0
# $FUND gives this share (basis points) of its creator rewards to SEAL (api/projectfund.mjs); 5000 = 50%
PROJECT_DONATION_BPS=5000
# SEAL's own Solana address, once SEAL confirms it; until then SEAL's half waits in its holding wallet
SEAL_SOLANA_ADDRESS=
